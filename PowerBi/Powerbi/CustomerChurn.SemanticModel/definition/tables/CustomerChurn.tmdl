	column TenureGroup = SWITCH(TRUE(), 'CustomerChurn'[tenure] <= 12, "0-12", 'CustomerChurn'[tenure] <= 24, "13-24", 'CustomerChurn'[tenure] <= 36, "25-36", 'CustomerChurn'[tenure] <= 48, "37-48", 'CustomerChurn'[tenure] <= 60, "49-60", "61-72")
		dataType: string
