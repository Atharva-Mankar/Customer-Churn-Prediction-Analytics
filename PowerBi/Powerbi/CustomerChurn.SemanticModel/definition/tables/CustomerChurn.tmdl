table CustomerChurn
	lineageTag: 96df4198-eeac-4840-970e-7fe3901fd974

	measure 'Total Customers' = COUNTROWS('CustomerChurn')
		lineageTag: c9ec0f68-9bb5-422e-8d2d-10fce64b806d

	measure 'Churned Customers' = CALCULATE(COUNTROWS('CustomerChurn'), 'CustomerChurn'[ChurnLabel] = "Yes")
		lineageTag: c3ed1b91-b88d-435f-b1ca-597b7c72b704

	measure 'Churn Rate' = DIVIDE([Churned Customers], [Total Customers])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: e302e4e6-5754-4feb-b08e-d6b78bca96c6

	measure 'Avg Monthly Charges' = AVERAGE('CustomerChurn'[MonthlyCharges])
		formatString: "₹"#,##0.00
		lineageTag: 9553603c-c243-4664-b65f-0d6bf9721f69

	measure 'Churn Rate %' = DIVIDE(COUNTROWS('CustomerChurn'), CALCULATE(COUNTROWS('CustomerChurn'), ALLSELECTED('CustomerChurn'[ChurnLabel])))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 3c467360-1e32-4d38-b7d1-42dc608019f3

